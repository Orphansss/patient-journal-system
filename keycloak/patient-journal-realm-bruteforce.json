{
  "realm": "patient-journal",
  "enabled": true,
  "displayName": "Patient Journal",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxTemporaryLockouts": 0,
  "bruteForceStrategy": "MULTIPLE",
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 5,
  "maxSecondaryAuthFailures": 0,
  "roles": {
    "realm": [
      {
        "name": "Patient",
        "description": "Patient user"
      },
      {
        "name": "Doctor",
        "description": "Doctor user"
      },
      {
        "name": "Secretary",
        "description": "Secretary user"
      },
      {
        "name": "Admin",
        "description": "Administrator"
      }
    ]
  },
  "clients": [
    {
      "clientId": "patient-journal-system",
      "name": "Patient Journal System",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "secret": "patient-journal-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": [
        "http://localhost:5000/*",
        "http://localhost:5103/*",
        "https://localhost:7285/*"
      ],
      "webOrigins": [
        "http://localhost:5000",
        "http://localhost:5103",
        "https://localhost:7285"
      ],
      "attributes": {
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "audience patient-journal-system",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "patient-journal-system",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "doctor@klinik.dk",
      "email": "doctor@klinik.dk",
      "firstName": "Dr. Anders",
      "lastName": "Nielsen",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Doctor123!",
          "temporary": false
        }
      ],
      "realmRoles": [
        "Doctor"
      ]
    },
    {
